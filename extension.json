{
  "apiVersion": 1,
  "id": "at365.profile",
  "name": "Applet.Profile.at365",
  "displayName": "%applet.displayName%",
  "icon": "user",
  "tagline": "%applet.tagline%",
  "version": "0.2.0",
  "updateRepository": "yukichi-7sai/Applet.Profile.at365",
  "minimumHostVersion": "0.159.0",
  "localization": { "defaultLanguage": "ja" },
  "description": "%applet.description%",
  "runtime": "node",
  "entry": "index.cjs",
  "capabilities": ["settings", "ribbon-items"],
  "settings": [
    { "key": "name", "title": "%settings.name.title%", "description": "%settings.name.description%", "type": "string", "default": "ユーザー", "minLength": 1, "maxLength": 80 },
    { "key": "avatar", "title": "%settings.avatar.title%", "description": "%settings.avatar.description%", "type": "registered-image", "default": null }
  ],
  "settingSections": [{ "id": "profile", "title": "%settings.profile.title%", "settings": ["name", "avatar"] }],
  "ribbonItems": [{ "id": "main", "title": "%ribbon.main.title%", "action": "settings", "icon": "user", "imageSetting": "avatar", "imageShape": "circle", "iconOnly": true, "defaultPlacement": "bottom" }]
}
